{
  "name": "@jesscss/compiler",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "Generic compiler host for Jess-compatible stylesheet language plugins",
  "version": "2.0.0-alpha.12",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./diagnostics": {
      "types": "./lib/diagnostics.d.ts",
      "import": "./lib/diagnostics.js",
      "require": "./lib/diagnostics.cjs"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "import": "./lib/config.js",
      "require": "./lib/config.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "ci": "pnpm build && pnpm test",
    "prepublishOnly": "npm run build",
    "build": "pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest --run --passWithNoTests",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "dependencies": {
    "@jesscss/core": "workspace:*",
    "linecraft": "0.2.8",
    "lodash-es": "^4.17.21",
    "styles-config": "workspace:*"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.8"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "module": "lib/index.js"
}
