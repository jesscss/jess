{
  "name": "@jesscss/jess-parser",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.0-alpha.5",
  "description": "Jess CST parser",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "source": "./src/index.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./cst": {
      "types": "./lib/cst.d.ts",
      "source": "./src/cst.ts",
      "import": "./lib/cst.js",
      "require": "./lib/cst.cjs"
    },
    "./grammar": {
      "types": "./lib/grammar.d.ts",
      "source": "./src/grammar.ts",
      "import": "./lib/grammar.js",
      "require": "./lib/grammar.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "ci": "pnpm build && pnpm test",
    "prepublishOnly": "npm run build",
    "build": "pnpm clean && pnpm compile",
    "clean": "shx rm -rf ./lib tsconfig.tsbuildinfo",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly --noCheck",
    "test": "vitest --run --passWithNoTests",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "author": "Matthew Dean",
  "license": "MIT",
  "dependencies": {
    "@jesscss/css-parser": "workspace:*",
    "color-name": "~2.0.0"
  },
  "peerDependencies": {
    "@jesscss/core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@jesscss/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jesscss/core": "workspace:*",
    "@types/color-name": "^1.1.1",
    "parseman": "link:/Users/matthew/git/oss/parser-thing"
  },
  "type": "module",
  "module": "lib/index.js"
}
