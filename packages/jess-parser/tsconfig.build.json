{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "noEmit": false,
    "paths": {
      "@jesscss/css-parser": ["./node_modules/@jesscss/css-parser/lib/index.d.ts"],
      "@jesscss/less-parser": ["./node_modules/@jesscss/less-parser/lib/index.d.ts"],
      "@jesscss/scss-parser": ["./node_modules/@jesscss/scss-parser/lib/index.d.ts"],
      "@jesscss/parser": ["./node_modules/@jesscss/parser/lib/index.d.ts"]
    }
  },
  "include": ["src/grammar.ts", "src/grammar-rules.ts", "src/builders.ts", "src/parser.ts", "src/index.ts", "src/jessTokens.ts"],
  "exclude": ["node_modules", "lib"]
}
