{
  "name": "jess-docs",
  "version": "2.0.0-alpha.1",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "build:facings": "pnpm --filter @jesscss/docs-content build:facings",
    "predev": "pnpm run build:facings",
    "dev": "docusaurus start",
    "prebuild": "pnpm run build:facings",
    "build": "pnpm run build:facings && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "pnpm run build:facings && docusaurus deploy",
    "deploy:matthew": "GIT_USER=matthew-dean USE_SSH=true CURRENT_BRANCH=alpha pnpm run deploy",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "clsx": "^1.2.1",
    "prism-react-renderer": "~2.4.1",
    "react": "~19.1.0",
    "react-dom": "~19.1.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@docusaurus/plugin-content-docs": "~3.8.1",
    "@docusaurus/theme-classic": "~3.8.1",
    "@docusaurus/types": "~3.8.1",
    "@types/react": "~19.1.10"
  }
}
