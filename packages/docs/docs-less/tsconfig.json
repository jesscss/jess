{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@site": ["./"],
      "@site/*": ["./*"],
      "@generated": [".docusaurus"],
      "@generated/*": [".docusaurus/*"]
    },
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["dom", "dom.iterable", "es6"]
  },
  "include": ["src", ".docusaurus", "docusaurus.config.ts"]
}
