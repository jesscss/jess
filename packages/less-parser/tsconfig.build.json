{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "types": ["node"],
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@jesscss/css-parser": ["./node_modules/@jesscss/css-parser/lib/index.d.ts"],
      "@jesscss/parser": ["./node_modules/@jesscss/parser/lib/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/__tests__/**"
  ]
}
