{
  "name": "styles-config",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.0-alpha.5",
  "description": "General-purpose configuration for styling frameworks (Jess, Less, Sass, Tailwind, etc.)",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "source": "./src/index.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly --noCheck",
    "test": "vitest"
  },
  "dependencies": {
    "@jesscss/core": "workspace:*",
    "cosmiconfig": "^9.0.0",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  },
  "author": "Matthew Dean",
  "license": "MIT",
  "module": "lib/index.js"
}
