{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "noEmit": false,
    "composite": false,
    "paths": {
      "styles-config": ["./node_modules/styles-config/lib/index.d.ts"],
      "@jesscss/compiler": ["./node_modules/@jesscss/compiler/lib/index.d.ts"],
      "@jesscss/compiler-preset": ["./node_modules/@jesscss/compiler-preset/lib/index.d.ts"],
      "@jesscss/plugin-less": ["./node_modules/@jesscss/plugin-less/lib/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
