    (Comment '// media queries - don\\'t extend outside, do extend inside')
    (AtRule
      name: 
        (Any [role=atkeyword] '@media')
      prelude: 
        (Paren
          (QueryCondition
            [
              (Keyword [role=keyword] 'tv')
            ]
          )
        )
      rules: 
        (Rules
          [
            (Ruleset
              selector: 
                (BasicSelector '.ma')
              rules: 
                (Rules
                  [
                    (Extend
                      target: 
                        (SelectorList
                          [
                            (BasicSelector '.a')
                            (BasicSelector '.b')
                            (BasicSelector '.c')
                            (BasicSelector '.d')
                            (BasicSelector '.e')
                            (BasicSelector '.f')
                            (BasicSelector '.g')
                            (BasicSelector '.h')
                            (BasicSelector '.i')
                            (BasicSelector '.j')
                            (BasicSelector '.k')
                            (BasicSelector '.l')
                            (BasicSelector '.m')
                            (BasicSelector '.n')
                            (BasicSelector '.o')
                            (BasicSelector '.p')
                            (BasicSelector '.q')
                            (BasicSelector '.r')
                            (BasicSelector '.s')
                            (BasicSelector '.t')
                            (BasicSelector '.u')
                            (BasicSelector '.v')
                            (BasicSelector '.w')
                            (BasicSelector '.x')
                            (BasicSelector '.y')
                            (BasicSelector '.z')
                            (BasicSelector '.md')
                          ]
                        )
                      flag: 1
                    )
                    (Declaration
                      name: 
                        (Any [role=property] 'color')
                      value: 
                        (Color
                          node: 'black'
                          rgb:
                            [0, 0, 0]
                          alpha: 1
                        )
                    )
                  ]
                )
            )
            (Ruleset
              selector: 
                (BasicSelector '.md')
              rules: 
                (Rules
                  [
                    (Declaration
                      name: 
                        (Any [role=property] 'color')
                      value: 
                        (Any [role=ident] 'inherit')
                    )
                  ]
                )
            )
            (AtRule
              name: 
                (Any [role=atkeyword] '@media')
              prelude: 
                (Paren
                  (QueryCondition
                    [
                      (Keyword [role=keyword] 'plasma')
                    ]
                  )
                )
              rules: 
                (Rules
                  [
                    (Rules
                      [
                        (Extend
                          selector: 
                            (SelectorList
                              [
                                (BasicSelector '.me')
                                (BasicSelector '.mf')
                              ]
                            )
                          target: 
                            (SelectorList
                              [
                                (BasicSelector '.mb')
                                (BasicSelector '.md')
                              ]
                            )
                          flag: 1
                        )
                        (Ruleset
                          selector: 
                            (SelectorList
                              [
                                (BasicSelector '.me')
                                (BasicSelector '.mf')
                              ]
                            )
                          rules: 
                            (Rules
                              [
                                (Nil '')
                                (Declaration
                                  name: 
                                    (Any [role=property] 'background')
                                  value: 
                                    (Color
                                      node: 'red'
                                      rgb:
                                        [255, 0, 0]
                                      alpha: 1
                                    )
                                )
                              ]
                            )
                        )
                      ]
                    )
                  ]
                )
            )
          ]
        )
    )
    (Ruleset
      selector: 
        (BasicSelector '.mb')
      rules: 
        (Rules
          [
            (Extend
              target: 
                (BasicSelector '.ma')
              flag: 1
            )
          ]
        )
    )
    (Ruleset
      selector: 
        (BasicSelector '.mc')
      rules: 
        (Rules
          [
            (Extend
              target: 
                (BasicSelector '.mb')
              flag: 1
            )
          ]
        )
    )
  ]
)"
`;
