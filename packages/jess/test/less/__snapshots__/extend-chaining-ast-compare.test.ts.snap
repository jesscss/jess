exports[`extend-chaining AST: parsed vs constructed (serializeTypes comparison) > serializes AST constructed in core for media-extend case (extend-chaining.less media block) 1`] = `
"(Rules
  [
    (Ruleset
      selector: 
        (SelectorList
          [
            (ComplexSelector
              [
                (BasicSelector '.a')
              ]
            )
          ]
        )
      rules: 
        (Rules
          [
            (Declaration
              name: 
                (Any [role=property] 'color')
              value: 
                (Any 'black')
            )
          ]
        )
    )
    (AtRule
      name: 
        (Any '@media')
      prelude: 
        (Any '(tv)')
      rules: 
        (Rules
          [
            (Ruleset
              selector: 
                (BasicSelector '.ma')
              rules: 
                (Rules
                  [
                    (Declaration
                      name: 
                        (Any [role=property] 'color')
                      value: 
                        (Any 'black')
                    )
                    (Extend
                      target: 
                        (BasicSelector '.a')
                    )
                    (Extend
                      target: 
                        (BasicSelector '.md')
                    )
                  ]
                )
            )
            (Ruleset
              selector: 
                (BasicSelector '.md')
              rules: 
                (Rules
                  [
                    (Declaration
                      name: 
                        (Any [role=property] 'color')
                      value: 
                        (Any 'inherit')
                    )
                  ]
                )
            )
          ]
        )
    )
    (Ruleset
      selector: 
        (BasicSelector '.mb')
      rules: 
        (Rules
          [
            (Extend
              target: 
                (BasicSelector '.ma')
            )
          ]
        )
    )
    (Ruleset
      selector: 
        (BasicSelector '.mc')
      rules: 
        (Rules
          [
            (Extend
              target: 
                (BasicSelector '.mb')
            )
          ]
        )
    )
  ]
)"
`;

