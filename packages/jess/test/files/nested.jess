@-compose "./imports/rule.jess";

*, *::before, *::after {
  box-sizing: inherit;
}

@media all {
  a {
    b {
      color: rebeccapurple;
    }
  }
}

a {
  color: blue;
  @media all {
    color: rebeccapurple;
  }
}

a {
  b {
    one: 1;
  }
  c {
    three: 3;
    d {
      five: 5;
    }
    four: 4;
  }
}
