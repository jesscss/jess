{
  "name": "jess",
  "type": "module",
  "version": "2.0.0-alpha.11",
  "description": "JavaScript Enhanced Style Sheets",
  "main": "lib/index.cjs",
  "types": "lib/index-public.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index-public.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "jess": "./bin/cli.mjs"
  },
  "files": [
    "lib",
    "bin"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@jesscss/compiler": "workspace:*",
    "@jesscss/compiler-preset": "workspace:*",
    "@jesscss/core": "workspace:*",
    "@jesscss/lint": "workspace:*",
    "@jesscss/patch-css": "workspace:*",
    "@jesscss/plugin-jess": "workspace:*",
    "@jesscss/plugin-less": "workspace:*",
    "@jesscss/plugin-node-modules": "workspace:*",
    "@jesscss/plugin-scss": "workspace:*",
    "lodash-es": "^4.17.21",
    "styles-config": "workspace:*"
  },
  "peerDependencies": {
    "@jesscss/plugin-js": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@jesscss/plugin-js": {
      "optional": true
    }
  },
  "scripts": {
    "ci": "pnpm build && pnpm run test:ratchet",
    "prepublishOnly": "pnpm build && pnpm run test:ratchet",
    "benchmark": "node bin/cli.mjs benchmark/benchmark.jess",
    "build": "pnpm compile && pnpm api-extractor",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "api-extractor": "api-extractor run --local --config ./api-extractor.json",
    "verify:api": "api-extractor run --config ./api-extractor.json",
    "dev": "tsdown --tsconfig tsconfig.build.json --watch",
    "test": "cross-env TEST=true vitest --watch=false",
    "test:all": "pnpm benchmark && pnpm test",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'",
    "test:ratchet": "node ../../scripts/vitest-ratchet.mjs --package . --baseline test/known-failures.json"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "devDependencies": {
    "@jesscss/css-parser": "workspace:*",
    "@jesscss/fns": "workspace:*",
    "@jesscss/plugin-js": "workspace:*",
    "@jesscss/plugin-less-compat": "workspace:*",
    "@jesscss/shared": "workspace:*",
    "@jesscss/jess-parser": "workspace:*",
    "@jesscss/less-parser": "workspace:*",
    "@jesscss/scss-parser": "workspace:*",
    "@types/lodash-es": "^4.17.8",
    "bootstrap": "~5.3.8",
    "bootstrap-less-port": "~2.5.1",
    "clinic": "~13.0.0",
    "sass": "~1.101.0"
  },
  "keywords": [
    "css",
    "less",
    "preprocessor",
    "pre-processor",
    "css-in-js",
    "front-end"
  ],
  "module": "lib/index.js"
}
