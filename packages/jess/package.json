{
  "name": "jess",
  "type": "module",
  "version": "2.0.0-alpha.4",
  "description": "JavaScript Enhanced Style Sheets",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts",
      "source": "./src/index.ts"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js",
      "source": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": "./bin/cli.mjs",
  "files": [
    "lib",
    "bin"
  ],
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "@jesscss/core": "workspace:*",
    "@jesscss/patch-css": "workspace:*",
    "@jesscss/plugin-less": "workspace:*",
    "@jesscss/plugin-node-modules": "workspace:*",
    "linecraft": "0.2.5",
    "lodash-es": "^4.17.21",
    "styles-config": "workspace:*"
  },
  "peerDependencies": {
    "@jesscss/plugin-js": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@jesscss/plugin-js": {
      "optional": true
    }
  },
  "scripts": {
    "ci": "pnpm build && pnpm test",
    "prepublishOnly": "pnpm build && pnpm test",
    "benchmark": "node bin/cli.mjs benchmark/benchmark.jess",
    "build": "pnpm compile",
    "compile": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.json -w",
    "test": "cross-env TEST=true vitest --watch=false",
    "test:all": "pnpm benchmark && pnpm test",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "devDependencies": {
    "@jesscss/plugin-js": "workspace:*",
    "@jesscss/plugin-less-compat": "workspace:*",
    "@jesscss/shared": "workspace:*",
    "@types/lodash-es": "^4.17.8",
    "less": "^4.0.0"
  },
  "keywords": [
    "css",
    "less",
    "preprocessor",
    "pre-processor",
    "css-in-js",
    "front-end"
  ]
}
