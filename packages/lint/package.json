{
  "name": "@jesscss/lint",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "Jess stylesheet lint policy and reporting",
  "version": "2.0.0-alpha.17",
  "engines": {
    "node": "^20.19.0 || >=22.18.0"
  },
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "bench:stylelint": "pnpm build && node test/stylelint-comparison-bench.mjs",
    "bench:stylelint:crossover": "pnpm build && node --expose-gc --experimental-strip-types test/stylelint-crossover-bench.ts",
    "test": "vitest --watch=false",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "dependencies": {
    "@jesscss/core": "workspace:*",
    "@jesscss/diagnostics-core": "workspace:*",
    "glob": "^10.2.1",
    "linecraft": "0.2.8",
    "styles-config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "postcss-less": "~6.0.0",
    "postcss-scss": "~4.0.9",
    "stylelint": "~17.14.1",
    "typescript": "~5.8.2",
    "vitest": "^4.1.0"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "module": "lib/index.js"
}
