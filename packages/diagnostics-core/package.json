{
  "name": "@jesscss/diagnostics-core",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared Jess stylesheet diagnostics for editor and CLI surfaces",
  "version": "2.0.0-alpha.13",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly --noCheck",
    "test": "vitest --watch=false",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "dependencies": {
    "@jesscss/core": "workspace:*",
    "@jesscss/css-parser": "workspace:*",
    "@jesscss/jess-parser": "workspace:*",
    "@jesscss/less-parser": "workspace:*",
    "@jesscss/scss-parser": "workspace:*",
    "@vscode/web-custom-data": "^0.6.2",
    "known-css-properties": "~0.37.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.0"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "module": "lib/index.js"
}
