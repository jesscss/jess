{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "noEmit": false,
    "composite": false,
    "paths": {
      "@jesscss/compiler": ["./node_modules/@jesscss/compiler/lib/index.d.ts"],
      "@jesscss/core": ["./node_modules/@jesscss/core/lib/index.d.ts"],
      "@jesscss/plugin-jess": ["./node_modules/@jesscss/plugin-jess/lib/index.d.ts"],
      "@jesscss/plugin-less": ["./node_modules/@jesscss/plugin-less/lib/index.d.ts"],
      "@jesscss/plugin-node-modules": ["./node_modules/@jesscss/plugin-node-modules/lib/index.d.ts"],
      "@jesscss/plugin-scss": ["./node_modules/@jesscss/plugin-scss/lib/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
