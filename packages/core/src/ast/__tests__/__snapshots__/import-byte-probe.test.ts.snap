// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`import byte probe > less, no loader 1`] = `
"--- "@import \\"a.less\\";"
@import "a.less";

--- "@import \\"a.css\\";"
@import "a.css";

--- "@import url(\\"a.css\\");"
@import url("a.css");

--- "@import (css) \\"a\\";"
@import "a";

--- "@import (inline) \\"a.txt\\";"
@import "a.txt";

--- "@import (inline) \\"a.txt\\" (min-width: 100px);"
@media (min-width: 100px) {
  @import "a.txt";
}

--- "@import (reference) \\"a\\";"
@import "a";

--- "@import (optional) \\"nope\\";"
@import "nope";

--- "@import \\"@{name}.css\\";"
!! error resolve/name-not-found [resolve] (unknown) — Name not found
Reason: Symbol "@name" is undefined in this scope.
Fix: Define "@name" or import a file that provides it.
--- "@import \\"a\\" screen and (min-width: 100px);"
@media screen and (min-width: 100px) {
  @import "a";
}

--- "@import (css) \\"a.css\\";"
@import "a.css";

--- "@import (less) \\"a.css\\";"
@import "a.css";

--- "@import (multiple) \\"a\\";"
@import "a";

--- "@import \\"a.css\\" screen;"
@import "a.css" screen;

--- "@import \\"a.css\\";\\n@import \\"a.css\\";\\n.x { color: red; }"
@import "a.css";
.x {
  color: red;
}

--- "@import \\"http://example.com/a\\";"
@import "http://example.com/a";

--- "@name: b;\\n@import \\"@{name}.css\\";"
@import "b.css";

--- "@w: 100px;\\n@import (css) \\"a.css\\" (min-width: @w);"
@import "a.css" (min-width: 100px);

--- "@import (reference) \\"a.css\\";"
@import "a.css";
"
`;

