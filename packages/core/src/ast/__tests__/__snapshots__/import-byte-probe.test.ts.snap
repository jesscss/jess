exports[`import byte probe > scss, no loader 1`] = `
"--- "@use \\"x\\";"
@-compose "x";

--- "@use \\"x\\" as y;"
@-compose "x" as y;

--- "@forward \\"x\\";"
@-export "x";

--- "@import \\"partial\\";"
@import "partial";

--- "@import \\"a.css\\";"
@import "a.css";

--- "@use \\"x\\" with ($a: 1px);"
@-compose "x";

--- "@import url(\\"a.css\\");"
@import url("a.css");

--- "@import \\"a\\" screen;"
!! A compile-time @import cannot carry a media query."
`;

