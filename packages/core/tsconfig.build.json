{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {},
    "rootDir": "./src",
    "outDir": "./lib",
    "lib": ["esnext"],
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/globals.d.ts"],
  "exclude": ["node_modules", "lib", "**/__tests__/**/*", "**/*.js", "src/**/*.js"]
}