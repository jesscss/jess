{
  "name": "@jesscss/core",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.0-alpha.5",
  "description": "The Jess Core Library",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "source": "./src/index.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "@jesscss/awaitable-pipe": "workspace:*",
    "@jridgewell/gen-mapping": "~0.3.12",
    "@ungap/set-methods": "~0.1.1",
    "bitset": "~5.2.3",
    "chalk": "^5.2.0",
    "combinate": "^1.1.11",
    "data-structure-typed": "~2.0.0",
    "enhanced-resolve": "~5.18.3",
    "chevrotain": "^12.0.0",
    "lodash-es": "^4.17.21"
  },
  "scripts": {
    "ci": "pnpm build && pnpm test -- --run",
    "prepublishOnly": "pnpm build && pnpm test -- --run",
    "build": "pnpm compile",
    "visualize": "vite build",
    "compile": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsdown --tsconfig tsconfig.build.json --no-dts",
    "build:types": "node ../../tools/tsdown/write-index-types-shim.mjs",
    "dev": "tsdown --tsconfig tsconfig.build.json --no-dts --watch",
    "test": "cross-env TEST=true vitest",
    "test:bench": "cross-env TEST=true vitest --run --include '**/bench*'",
    "test:coverage": "cross-env TEST=true vitest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "devDependencies": {
    "@types/lodash-es": "^4.17.8",
    "rollup-plugin-circular-dependencies": "~1.1.2",
    "rollup-plugin-visualizer": "~6.0.3",
    "vite-plugin-circular-dependency": "~0.5.0",
    "vite-plugin-externalize-deps": "~0.9.0",
    "vite-plugin-node-polyfills": "~0.23.0"
  }
}
