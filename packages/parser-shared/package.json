{
  "name": "@jesscss/parser-shared",
  "version": "2.0.0-alpha.5",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.18.0"
  },
  "description": "Shared Parseman grammar facts for Jess syntax parsers",
  "exports": {
    "./recognition": {
      "types": "./lib/recognition.d.ts",
      "import": "./lib/recognition.js",
      "require": "./lib/recognition.cjs"
    },
    "./opaque-at-rule": {
      "types": "./lib/opaque-at-rule.d.ts",
      "import": "./lib/opaque-at-rule.js",
      "require": "./lib/opaque-at-rule.cjs"
    },
    "./pseudo-consts": {
      "types": "./lib/pseudo-consts.d.ts",
      "import": "./lib/pseudo-consts.js",
      "require": "./lib/pseudo-consts.cjs"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly"
  },
  "peerDependencies": {
    "parseman": "^0.50.5"
  },
  "devDependencies": {
    "parseman": "^0.50.5",
    "tsdown": "~0.21.7"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme"
}
