{
  "name": "@jesscss/plugin-remote-import",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesscss/jess.git",
    "directory": "packages/jess-plugin-remote-import"
  },
  "version": "2.0.0-alpha.5",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Opt-in Jess plugin that fetches https @import sources from an explicit host allowlist",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "pnpm compile",
    "ci": "pnpm build && pnpm test",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsdown --tsconfig tsconfig.build.json --watch",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'",
    "test": "vitest --run"
  },
  "dependencies": {
    "@jesscss/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "deno": "^2.6.8",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "lib/index.js"
}
