{
  "name": "@jesscss/parser",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.0-alpha.1",
  "description": "Jess CST parser",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts",
      "source": "./src/index.ts"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js",
      "source": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "ci": "pnpm build && pnpm test",
    "prepublishOnly": "npm run build",
    "build": "pnpm clean && pnpm compile",
    "clean": "shx rm -rf ./lib tsconfig.tsbuildinfo",
    "compile": "tsc -p tsconfig.build.json",
    "test": "vitest --run --passWithNoTests",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "author": "Matthew Dean",
  "license": "MIT",
  "dependencies": {
    "@jesscss/css-parser": "workspace:*",
    "chevrotain": "^10.5.0"
  }
}
