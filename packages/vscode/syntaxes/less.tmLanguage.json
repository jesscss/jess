{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jess Less (fallback)",
  "scopeName": "source.less",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#selectors" },
    { "include": "#atRules" },
    { "include": "#variables" },
    { "include": "#properties" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.less", "begin": "/\\*", "end": "\\*/" },
        {
          "name": "comment.line.double-slash.less",
          "match": "(?<!https:)(?<!http:)(?<!:)//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.less", "begin": "\"", "end": "\"", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.less" }] },
        { "name": "string.quoted.single.less", "begin": "'", "end": "'", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.less" }] }
      ]
    }
    ,
    "atRules": {
      "patterns": [
        {
          "name": "keyword.control.at-rule.less",
          "match": "(?m)^[ \\t]*@(?![_a-zA-Z][\\w-]*:|[_a-zA-Z][\\w-]*[ \\t]+:[ \\t])(?>[\\w-]+)"
        }
      ]
    },
    "selectors": {
      "patterns": [
        { "name": "meta.attribute-selector.less", "match": "\\[[^\\]]+\\]" },
        {
          "name": "meta.selector.less",
          "match": "(?m)(^|[\\s{;,(]|\\.|#|&|\\]|\\))(\\&+)",
          "captures": { "2": { "name": "entity.name.tag.less" } }
        },
        {
          "name": "meta.selector.less",
          "match": "(?m)(^|[\\s{;,(]|\\.|#|&|\\]|\\))(\\.[_a-zA-Z][\\w-]*)",
          "captures": { "2": { "name": "entity.name.tag.less" } }
        },
        {
          "name": "meta.selector.less",
          "match": "(?m)(^|[\\s{;,(]|\\.|#|&|\\]|\\))(#[_a-zA-Z][\\w-]*)",
          "captures": { "2": { "name": "entity.name.tag.less" } }
        },
        {
          "name": "meta.selector.less",
          "match": "(?m)^[ \\t]*([_a-zA-Z][\\w-]*)(?=\\s*[,{])",
          "captures": { "1": { "name": "entity.name.tag.less" } }
        },
        { "name": "entity.name.tag.less", "match": ":[_a-zA-Z-][\\w-]*" }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.constant.less",
          "match": "(?m)^[ \\t]*(?:(@[_a-zA-Z][\\w-]*):|(@[_a-zA-Z][\\w-]*)[ \\t]+:(?=[ \\t]))",
          "captures": {
            "1": { "name": "variable.other.constant.less" },
            "2": { "name": "variable.other.constant.less" }
          }
        },
        {
          "name": "variable.other.constant.less",
          "match": "@[_a-zA-Z][\\w-]*"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "meta.property-name.less",
          "match": "(?m)(^|[\\s{;])([_a-zA-Z][\\w-]*)\\s*:",
          "captures": { "2": { "name": "support.type.property-name.less" } }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "meta.dimension.less",
          "match": "(?<![\\w-])([+-]?(?:\\d*\\.\\d+|\\d+))(?:([a-zA-Z]+|%))",
          "captures": {
            "1": { "name": "constant.numeric.less" },
            "2": { "name": "constant.other.unit.less" }
          }
        },
        { "name": "constant.numeric.less", "match": "(?<![\\w-])[+-]?(?:\\d*\\.\\d+|\\d+)" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "support.function.less", "match": "\\b[_a-zA-Z][\\w-]*(?=\\()" }
      ]
    }
  }
}

