{
  "name": "@jesscss/language-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/server.js",
      "require": "./lib/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@jesscss/css-parser": "workspace:*",
    "@jesscss/jess-parser": "workspace:*",
    "@jesscss/less-parser": "workspace:*",
    "@jesscss/scss-parser": "workspace:*",
    "@jesscss/style-resolver": "workspace:*",
    "@vscode/web-custom-data": "^0.6.2",
    "known-css-properties": "~0.37.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@jesscss/shared": "workspace:*",
    "@types/node": "^20.0.0",
    "cross-env": "~7.0.3",
    "typescript": "~5.8.2",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "build": "pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly --noCheck",
    "dev": "tsdown --tsconfig tsconfig.build.json --watch",
    "test": "vitest --watch=false",
    "test:unit": "vitest --watch=false"
  },
  "module": "lib/index.js"
}
