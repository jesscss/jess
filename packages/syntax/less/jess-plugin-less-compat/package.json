{
  "name": "@jesscss/plugin-less-compat",
  "publishConfig": {
    "access": "public"
  },
  "description": "Less function compatibility bridge for Jess",
  "version": "2.0.0-alpha.11",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "ci": "pnpm build && pnpm test",
    "prepublishOnly": "npm run build",
    "build": "pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "cross-env TEST=true vitest --run",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "dependencies": {
    "@jesscss/awaitable-pipe": "workspace:*",
    "@jesscss/core": "workspace:*",
    "@jesscss/less-parser": "workspace:*",
    "@jesscss/plugin-node-modules": "workspace:*"
  },
  "devDependencies": {
    "less-plugin-autoprefix": "^2.0.0",
    "less-plugin-clean-css": "^1.6.0",
    "less-plugin-dls": "^1.5.0"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "module": "lib/index.js"
}
