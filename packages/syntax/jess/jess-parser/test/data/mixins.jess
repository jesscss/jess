domeMixin() {
  one: 1;
  two: 2;
}
domeMixin() {
  one: 1;
  two: 2;
}
domeMixin($one, $two) when ($two = 2) {}
domeMixin($one, $two: 2) {}
domeMixin($one: 1, $two: 2) {}

$ > domeMixin();
$ > domeMixin(1);
$ > domeMixin(1, 2);

$one_1_cond: true;
$one_2_cond: true;

def() {
  color: red;
}

$if (($one_1_cond = true) and ($one_2_cond = true)) { $ > def(); }
