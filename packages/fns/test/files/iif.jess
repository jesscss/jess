/**
 * Like Less guards with default()
 */
one($value) {
  one_1() {
    width: 2px;
  }
  one_2() {
    height: 10px;
  }
  def() {
    width: 4px;
  }

  $if ($value > 1) { $ > one_1(); }
  $if ($value > 5) { $ > one_2(); }
  $if (not ($value > 1) and not ($value > 5)) { $ > def(); }
}

.box-0 {
  $ > one(0);
}
.box-2 {
  $ > one(2);
}
.box-10 {
  $ > one(10);
  $if (true) { color: #333; } $else { color: #555; }
  $if (false) { background-color: #333; } $else { background-color: #555; }
}
