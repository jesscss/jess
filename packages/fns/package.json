{
  "name": "@jesscss/fns",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.0-alpha.6",
  "description": "Jess functions module",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "source": "./src/index.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "source": "./src/*.ts",
      "import": "./lib/*.js",
      "require": "./lib/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "ci": "pnpm build && pnpm test",
    "prepublishOnly": "npm run build",
    "build": "pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "cross-env TEST=true vitest",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "dependencies": {
    "@jesscss/core": "workspace:*",
    "@jesscss/awaitable-pipe": "workspace:*",
    "color-name": "~2.0.0",
    "lodash-es": "^4.17.21",
    "superstruct": "1.0.3"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.8"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "module": "lib/index.js"
}
