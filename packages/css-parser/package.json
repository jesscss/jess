{
  "name": "@jesscss/css-parser",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.0-alpha.5",
  "description": "Jess CSS base parser",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./cst": {
      "types": "./lib/cst-css.d.ts",
      "import": "./lib/cst.js",
      "require": "./lib/cst.cjs"
    },
    "./grammar": {
      "types": "./lib/grammar.d.ts",
      "import": "./lib/grammar.js",
      "require": "./lib/grammar.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "verify:types": "tsc -p tsconfig.build.json --noEmit --skipLibCheck",
    "ci": "pnpm build && pnpm test",
    "prepublishOnly": "pnpm build",
    "build": "pnpm --filter @jesscss/internal-css-recognition build && pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly --noCheck",
    "dev": "tsdown --tsconfig tsconfig.build.json --no-dts --watch",
    "test": "cross-env TEST=true vitest --watch=false",
    "test:coverage": "cross-env TEST=true vitest --coverage",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "dependencies": {},
  "peerDependencies": {
    "@jesscss/core": "workspace:*",
    "parseman": "^0.29.0"
  },
  "peerDependenciesMeta": {
    "@jesscss/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jesscss/core": "workspace:*",
    "@jesscss/internal-css-recognition": "workspace:*",
    "@jesscss/shared": "workspace:*",
    "parseman": "0.29.0",
    "tsx": "~4.21.0"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "module": "lib/index.js"
}
