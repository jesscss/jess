{
  "name": "@jesscss/css-parser",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.0.0-alpha.5",
  "description": "Jess CSS base parser",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts",
      "source": "./src/index.ts",
      "require": "./lib/index.cjs"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js",
      "source": "./src/*.ts",
      "require": "./lib/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "ci": "pnpm build && pnpm test",
    "prepublishOnly": "pnpm build",
    "build": "pnpm compile",
    "compile": "tsdown --tsconfig tsconfig.build.json && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsdown --tsconfig tsconfig.build.json --watch",
    "bench": "tsx test/bench.ts",
    "bench:save": "tsx test/bench.ts --save",
    "test": "cross-env TEST=true vitest --watch=false",
    "test:coverage": "cross-env TEST=true vitest --coverage",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "eslint '**/*.{js,ts}'"
  },
  "dependencies": {
    "@jesscss/core": "workspace:*",
    "color-name": "~2.0.0",
    "lodash-es": "~4.17.21",
    "xregexp": "^5.1.1"
  },
  "devDependencies": {
    "@jesscss/shared": "workspace:*",
    "@types/color-name": "^1.1.1",
    "@types/lodash-es": "~4.17.8",
    "@types/xregexp": "^4.4.0",
    "chevrotain": "^12.0.0",
    "tsx": "~4.21.0"
  },
  "author": "Matthew Dean <matthew-dean@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jesscss/jess/issues"
  },
  "homepage": "https://github.com/jesscss/jess#readme",
  "module": "lib/index.js"
}
