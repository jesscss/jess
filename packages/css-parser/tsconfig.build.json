{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": false,
    "composite": false,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": false,
    "isolatedDeclarations": true,
    "types": ["node"],
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "lib",
    "**/__tests__/**/*",
    "src/util/cst.ts"
  ]
}
