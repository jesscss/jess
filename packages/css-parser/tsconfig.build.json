{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "allowJs": false,
    "types": ["node"],
    "noEmit": false,
    "composite": false,
    "paths": {
      "@jesscss/parser": ["./node_modules/@jesscss/parser/lib/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "lib",
    "**/__tests__/**/*",
    "src/util/cst.ts"
  ]
}
