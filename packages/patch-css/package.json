{
  "name": "@jesscss/patch-css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesscss/jess.git",
    "directory": "packages/patch-css"
  },
  "type": "module",
  "version": "2.0.0-alpha.5",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && pnpm compile",
    "clean": "shx rm -rf ./lib tsconfig.tsbuildinfo",
    "compile": "tsdown --tsconfig tsconfig.build.json --no-dts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsc -p tsconfig.build.json -w",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "description": "Sets a Jess stylesheet's exposed variables on the page",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "author": "Matthew Dean",
  "license": "MIT",
  "sideEffects": false
}
