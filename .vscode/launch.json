{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest (Current File)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vitest",
        "--inspect-brk",
        "--no-coverage",
        "--run",
        "${relativeFile}"
      ],
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/*/lib/**/*.js",
        "${workspaceFolder}/packages/*/src/**/*.ts"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest (All Tests)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vitest",
        "--inspect-brk",
        "--no-coverage",
        "--run"
      ],
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/*/lib/**/*.js",
        "${workspaceFolder}/packages/*/src/**/*.ts"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest (Watch Mode)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vitest",
        "--inspect-brk",
        "--no-coverage"
      ],
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/*/lib/**/*.js",
        "${workspaceFolder}/packages/*/src/**/*.ts"
      ]
    }
  ]
}
