{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jesscss.local/tasks/event.schema.json",
  "title": "Jess Task Event",
  "type": "object",
  "required": [
    "event_id",
    "task_id",
    "event_type",
    "ts",
    "actor",
    "run_id"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "task_id": { "type": "string" },
    "event_type": { "type": "string" },
    "ts": { "type": "string" },
    "actor": { "type": "string" },
    "run_id": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object",
      "default": {}
    }
  },
  "additionalProperties": true
}
