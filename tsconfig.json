{
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "outDir": "./lib",
    "rootDir": ".",
    "declaration": true,
    "esModuleInterop": true,
    "module": "ES2020",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["es6"],
    "baseUrl": "./packages",
    "strict": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "paths": {
      "jess": ["jess/lib"],
      "@jess/*": ["*/src"]
    },
    "plugins": [
  
    ],
    "types": [
      "vitest/globals"
    ]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "lib"]
}