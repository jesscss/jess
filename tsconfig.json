{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["esnext"],
    "strict": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "jess": ["./packages/jess/lib"],
      "@jesscss/css-parser": ["./packages/syntax/css/css-parser/src/index.ts"],
      "@jesscss/css-parser/*": ["./packages/syntax/css/css-parser/src/*.ts"],
      "@jesscss/less-parser": ["./packages/syntax/less/less-parser/src/index.ts"],
      "@jesscss/less-parser/*": ["./packages/syntax/less/less-parser/src/*.ts"],
      "@jesscss/scss-parser": ["./packages/syntax/scss/scss-parser/src/index.ts"],
      "@jesscss/scss-parser/*": ["./packages/syntax/scss/scss-parser/src/*.ts"],
      "@jesscss/jess-parser/*": ["./packages/syntax/jess/jess-parser/src/*.ts"],
      "@jesscss/parser": ["./packages/parser/src/index.ts"],
      "@jesscss/fns": ["./packages/fns/src/index.ts"],
      "@jesscss/fns/*": ["./packages/fns/src/*.ts"],
      "@jesscss/plugin-node-modules": ["./packages/jess-plugin-node-modules/src/index.ts"],
      "@jesscss/plugin-less": ["./packages/syntax/less/jess-plugin-less/src/index.ts"],
      "styles-config": ["./packages/config/src/index.ts"]
    },
    "plugins": [
  
    ],
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "lib", "**/*.js"]
}
