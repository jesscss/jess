{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "esModuleInterop": true,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["esnext"],
    "baseUrl": "./packages",
    "strict": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "jess": ["jess/lib"],
      "@jess/*": ["*/src"]
    },
    "plugins": [
  
    ],
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "lib", "**/*.js"]
}