{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "esModuleInterop": true,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["esnext"],
    "strict": true,
    "useDefineForClassFields": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "jess": ["./packages/jess/lib"],
      "@jess/*": ["./packages/*/src"],
      "@jesscss/css-parser": ["./packages/css-parser/src/index.ts"],
      "@jesscss/parser": ["./packages/parser/src/index.ts"]
    },
    "plugins": [
  
    ],
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "lib", "**/*.js"]
}
